# Get a key at https://the-odds-api.com (free tier: 500 credits/month)
ODDS_API_KEY=

# Set to 1 to try the dashboard with fake odds, no key needed
DEMO=0

# Comma-separated. Defaults to every in-season sport and the NY-licensed books.
# SPORTS=americanfootball_nfl,basketball_nba
# BOOKMAKERS=draftkings,fanduel,betmgm,williamhill_us,betrivers,fanatics,espnbet,ballybet
# Prediction-market exchanges, fee-adjusted. Set EXCHANGES= (empty) to turn them off.
EXCHANGES=kalshi,polymarket
MARKETS=h2h,spreads,totals

# Seconds between sweeps. Each sweep costs ~3 credits per in-season sport.
POLL_SECONDS=300

BANKROLL=1000
STAKE_ROUNDING=1
MAX_MARGIN=0.10
MAX_ODDS_AGE_SECONDS=600
DB_PATH=arb.db
